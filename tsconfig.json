{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "vendor/**/*.ts"],
  "exclude": ["vendor/**/*.test.ts"]
}
