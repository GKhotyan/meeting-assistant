# Local Mac: http://localhost:8088
BIND_ADDRESS=127.0.0.1
PORT=8088
ACCESS_MODE=local
# For VPS: ACCESS_MODE=server, set a strong APP_PASSWORD and keep the app
# behind an HTTPS reverse proxy or SSH tunnel. Basic Auth user: assistant.
APP_PASSWORD=
# External browser origin when a reverse proxy rewrites Host (no path).
PUBLIC_ORIGIN=

# Host directories (use absolute paths on a shared VM).
# Private assistant settings and recurring schedules:
ASSISTANT_DATA_DIR=./data
# Shared recordings: pass exactly the same host path as RECORDINGS_DIR
# when starting meeting-analyzer. Existing recordings are not moved.
RECORDINGS_DIR=./data/recordings
